# 로컬 개발용 환경변수 예시입니다. 실제 값은 .env(커밋 금지) 또는 IDE 실행 설정에 입력하세요.
# Spring은 .env를 자동으로 읽지 않으므로 IntelliJ 실행 구성의 Environment variables에 넣어주세요.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/jjonggeut?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=*

# 인증(JWT) 구현 시 사용
JWT_SECRET=

# AI 기능(추천, 봉사 경험 정리) 구현 시 사용
AI_API_KEY=
